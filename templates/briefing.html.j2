<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
{% include "_base.css" %}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Operation {{ narrative.operation }}</div>
    <h1>{{ meta.subtitle or meta.title }}</h1>
    <div class="meta-row">
      <span>Date <b class="mono">{{ meta.date }}</b></span>
      <span>Step <b class="mono">{{ meta.start_time }}L</b></span>
      <span>Theater <b>{{ meta.theater | title }}</b></span>
      <span>Flight <b>{{ player.callsign }} · {{ player.count }}× {{ aircraft_name }}</b></span>
      <span>Base <b>{{ route[0].name }}</b></span>
    </div>
    {% if narrative.hook %}<blockquote class="hook">{{ narrative.hook | trim }}</blockquote>{% endif %}
  </div>
</header>

<nav class="sections" aria-label="Sections">
  <div class="wrap">
    <a href="#story">Story</a><a href="#plan">Storyboard &amp; map</a><a href="#brief">Briefing</a>
    <span class="spacer"></span>
    <button type="button" id="theme" aria-label="Toggle light or dark theme">Theme</button>
    <button type="button" onclick="window.print()">Print</button>
  </div>
</nav>

<main>
<section id="story">
  <div class="wrap">
    <h2>The story so far</h2>
    <div class="story">
      <div>{% for p in narrative.backstory | paras %}<p>{{ p }}</p>{% endfor %}</div>
      <div>
        <h3>Cast</h3>
        <ul class="cast">
          {% for c in narrative.characters %}<li><b>{{ c.name }}</b><span>{{ c.role }}</span></li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="plan">
  <div class="wrap">
    <h2>Storyboard &amp; flight plan</h2>
    <div class="plan">
      <div class="map-wrap">
        <div id="map" role="img" aria-label="Mission map with route, threats and target"></div>
        <div class="legend" id="legend">
          <label><input type="checkbox" data-layer="route" checked> <i style="background:var(--blue)"></i>Route</label>
          <label><input type="checkbox" data-layer="threats" checked> <i style="background:var(--red)"></i>Threat rings</label>
          <label><input type="checkbox" data-layer="support" checked> <i style="background:var(--ok)"></i>Friendly support</label>
          <label><input type="checkbox" data-layer="target" checked> <i style="background:var(--accent)"></i>Target</label>
        </div>
      </div>
      <ol class="timeline">
        {% for ph in storyboard %}
        <li class="phase" data-idx="{{ loop.index0 }}">
          <span class="dot">{{ loop.index }}</span>
          <button type="button" class="phase-card" aria-label="Show {{ ph.phase }} on the map">
            <div class="phase-head"><h3>{{ ph.phase }}</h3><span class="time">{{ ph.time }}</span></div>
            <p class="beat">{{ ph.brief | trim }}</p>
            {% if ph.waypoints %}<div class="chips">{% for w in ph.waypoints %}<span class="chip">{{ w }}</span>{% endfor %}</div>{% endif %}
          </button>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

<section id="brief">
  <div class="wrap">
    <h2>Briefing</h2>
    <div class="cards">
      <div class="card"><h3>Situation</h3>{% for p in situation | paras %}<p>{{ p }}</p>{% endfor %}</div>
      <div class="card"><h3>Objectives</h3>
        <ul class="obj-list">{% for k, v in objectives.items() %}<li><span>{{ k }}</span><div>{{ v }}</div></li>{% endfor %}</ul>
      </div>
      <div class="card"><h3>Rules of engagement</h3>{% for p in roe | paras %}<p>{{ p }}</p>{% endfor %}</div>

      <div class="card wide"><h3>Threats</h3>
        <div class="table-scroll"><table>
          <thead><tr><th>Type</th><th>System</th><th>Intel</th><th>Range</th><th>Notes</th></tr></thead>
          <tbody>{% for t in threats %}<tr>
            <td><span class="tag {{ t.kind }}">{{ t.kind }}</span></td><td>{{ t.name }}</td>
            <td><span class="intel {{ t.intel or 'confirmed' }}">{{ t.intel or "confirmed" }}</span></td>
            <td class="num">{% if t.range_km %}{{ t.range_km }} km{% else %}n/a{% endif %}</td><td>{{ t.notes }}</td>
          </tr>{% endfor %}</tbody>
        </table></div>
      </div>

      <div class="card"><h3>Target</h3>
        <dl class="kv">
          <dt>Name</dt><dd>{{ target.name }}</dd>
          <dt>Coords</dt><dd class="mono">{{ "%.4f"|format(target.lat) }}N {{ "%.4f"|format(target.lon) }}E{% if target.area_km %}<br><span class="intel suspected">estimate ±{{ target.area_km }} km</span>{% endif %}</dd>
          <dt>Description</dt><dd>{{ target.description }}</dd>
          <dt>DMPI</dt><dd>{{ target.dmpi }}</dd>
        </dl>
      </div>
      <div class="card"><h3>Flight &amp; loadout</h3>
        <dl class="kv">
          <dt>Callsign</dt><dd>{{ player.callsign }}-1 / -2</dd>
          <dt>Start</dt><dd>{{ player.start | title }} start, {{ route[0].name }}</dd>
          <dt>Loadout</dt><dd>{{ player.loadout_summary }}</dd>
          {% if player.laser_codes %}<dt>Laser</dt><dd class="mono">{{ player.laser_codes | join(" / ") }}</dd>{% endif %}
          <dt>Joker / Bingo</dt><dd class="mono">{{ player.joker_lbs }} / {{ player.bingo_lbs }} lb</dd>
        </dl>
      </div>
      <div class="card"><h3>Weather</h3>
        <dl class="kv">
          <dt>Wind</dt><dd class="mono">{{ "%03d"|format(meta.weather.wind_from_deg) }}° / {{ meta.weather.wind_kts }} kt</dd>
          <dt>Temp</dt><dd class="mono">{{ meta.weather.temperature_c }} °C</dd>
          <dt>QNH</dt><dd class="mono">{{ meta.weather.qnh_inhg }} inHg</dd>
          <dt>Clouds</dt><dd>{{ meta.weather.clouds }}</dd>
          <dt>Visibility</dt><dd>{{ meta.weather.visibility }}</dd>
        </dl>
      </div>

      <div class="card wide"><h3>Navigation</h3>
        <div class="table-scroll"><table>
          <thead><tr><th>#</th><th>Name</th><th>Position</th><th>Alt</th><th>Speed</th><th>ETA</th><th>Action</th></tr></thead>
          <tbody>{% for wp in player.waypoints %}<tr>
            <td class="num">{{ loop.index }}</td><td><b>{{ wp.name }}</b></td>
            <td class="num">{{ "%.4f"|format(wp.lat) }}N {{ "%.4f"|format(wp.lon) }}E</td>
            <td class="num">{{ "{:,}".format(wp.alt_ft) }} ft</td><td class="num">{{ wp.kts }} kt</td>
            <td class="num">{{ wp.eta }}</td><td>{{ wp.action | default("") | upper }}</td>
          </tr>{% endfor %}</tbody>
        </table></div>
      </div>

      <div class="card wide"><h3>Comms</h3>
        <div class="table-scroll"><table>
          <thead><tr><th>Station</th><th>Frequency</th><th>Notes</th></tr></thead>
          <tbody>{% for c in comms %}<tr><td>{{ c.name }}</td><td class="num">{{ c.freq }}</td><td>{{ c.notes }}</td></tr>{% endfor %}</tbody>
        </table></div>
      </div>
    </div>
  </div>
</section>

</main>

<footer><div class="wrap">Generated from <code>missions/{{ meta.id }}/mission.yaml</code>. Intel is what the squadron knows at brief time; it may be incomplete.</div></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
const D = {{ map_json | safe }};
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

// Theme toggle (remembered per viewer when storage is available)
(function () {
  const root = document.documentElement;
  try { const t = localStorage.getItem("dcsmb-theme"); if (t) root.dataset.theme = t; } catch (e) {}
  document.getElementById("theme").addEventListener("click", () => {
    const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    root.dataset.theme = dark ? "light" : "dark";
    try { localStorage.setItem("dcsmb-theme", root.dataset.theme); } catch (e) {}
    drawMap();
  });
})();

let map, layers = {}, routeLine, wpLatLng = {};
function drawMap() {
  if (typeof L === "undefined") { document.getElementById("map").textContent = "Map needs an internet connection (Leaflet CDN)."; return; }
  const center = map ? map.getCenter() : null, zoom = map ? map.getZoom() : null;
  if (map) map.remove();
  map = L.map("map", { zoomSnap: 0.5, scrollWheelZoom: false });
  const dark = document.documentElement.dataset.theme === "dark" ||
    (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
  L.tileLayer(`https://server.arcgisonline.com/ArcGIS/rest/services/${dark ? "Canvas/World_Dark_Gray_Base" : "World_Topo_Map"}/MapServer/tile/{z}/{y}/{x}`, {
    maxZoom: dark ? 16 : 18, attribution: "Tiles &copy; Esri"
  }).addTo(map);

  const blue = css("--blue"), red = css("--red"), amber = css("--amber"), ok = css("--ok"), accent = css("--accent");
  layers = { route: L.layerGroup(), threats: L.layerGroup(), support: L.layerGroup(), target: L.layerGroup() };

  const pts = D.route.map(p => [p.lat, p.lon]);
  routeLine = L.polyline(pts, { color: blue, weight: 3, opacity: .9 }).addTo(layers.route);
  D.route.forEach(p => {
    const ll = [p.lat, p.lon];
    if (p.kind === "wp") wpLatLng[p.name] = ll;
    const m = L.circleMarker(ll, { radius: p.kind === "base" ? 7 : 5, color: blue, weight: 2, fillColor: css("--surface"), fillOpacity: 1 })
      .addTo(layers.route)
      .bindTooltip(p.kind === "wp" ? `${p.num} ${p.name}` : p.name, { permanent: true, direction: "right", offset: [8, 0], className: "wp-label" });
    if (p.kind === "wp") m.bindPopup(`<b>WP${p.num} ${p.name}</b><br>${p.alt_ft.toLocaleString()} ft · ${p.kts} kt<br>ETA ${p.eta}${p.action ? "<br>Action: " + p.action.toUpperCase() : ""}`);
  });

  // Rings show intel, not truth: solid = confirmed, dashed = suspected, dotted = possible.
  const dash = { confirmed: null, suspected: "8 5", possible: "2 6" };
  D.threats.forEach(t => {
    const intel = t.intel || "confirmed";
    const c = t.kind === "aaa" ? amber : t.kind === "air" ? blue : t.kind === "armor" ? css("--muted") : red;
    const faint = intel === "possible" ? .5 : 1;
    if (t.area_km) L.circle([t.lat, t.lon], { radius: t.area_km * 1000, color: c, weight: 1, opacity: .7 * faint, fill: false, dashArray: "1 5" })
      .addTo(layers.threats).bindTooltip(`${t.name}: last known area`, { sticky: true });
    if (t.range_km) L.circle([t.lat, t.lon], { radius: t.range_km * 1000, color: c, weight: 1.5, opacity: faint, fillColor: c, fillOpacity: .06 * faint, dashArray: dash[intel] }).addTo(layers.threats);
    L.circleMarker([t.lat, t.lon], { radius: 5, color: c, fillColor: intel === "confirmed" ? c : css("--surface"), fillOpacity: 1, opacity: faint }).addTo(layers.threats)
      .bindPopup(`<b>${t.name}</b><br><i>Intel: ${intel}</i>${t.range_km ? "<br>Range " + t.range_km + " km" : ""}${t.area_km ? "<br>Position ±" + t.area_km + " km" : ""}<br>${t.notes || ""}`);
  });

  D.support.forEach(s => {
    const c = s.coalition === "red" ? red : ok;
    if (s.from && s.to) {
      L.polyline([[s.from.lat, s.from.lon], [s.to.lat, s.to.lon]], { color: c, weight: 3, dashArray: "2 6" }).addTo(layers.support)
        .bindTooltip(`${s.callsign} CAP`, { permanent: true, direction: "left", className: "wp-label" });
    } else if (s.lat) {
      L.circleMarker([s.lat, s.lon], { radius: 6, color: c, fillColor: c, fillOpacity: .9 }).addTo(layers.support)
        .bindTooltip(s.callsign, { permanent: true, direction: "left", className: "wp-label" });
    } else if (s.base_ll) {
      L.circleMarker([s.base_ll.lat, s.base_ll.lon], { radius: 6, color: c, fillColor: c, fillOpacity: .9 }).addTo(layers.support)
        .bindTooltip(`${s.callsign} (${s.base_ll.name})`, { permanent: true, direction: "left", className: "wp-label" });
    }
  });

  const tg = D.target;
  if (tg.area_km) L.circle([tg.lat, tg.lon], { radius: tg.area_km * 1000, color: accent, weight: 2, fill: false, dashArray: "4 6" })
    .addTo(layers.target).bindTooltip("Target search area", { sticky: true });
  L.marker([tg.lat, tg.lon], { icon: L.divIcon({ className: "", html: `<svg width="26" height="26" viewBox="0 0 26 26"><circle cx="13" cy="13" r="10" fill="none" stroke="${accent}" stroke-width="2.5"/><path d="M13 1v8M13 17v8M1 13h8M17 13h8" stroke="${accent}" stroke-width="2.5"/></svg>`, iconSize: [26, 26], iconAnchor: [13, 13] }) })
    .addTo(layers.target).bindPopup(`<b>${tg.name}</b>${tg.area_km ? "<br><i>Estimated position ±" + tg.area_km + " km</i>" : ""}<br>${tg.description || ""}`);

  document.querySelectorAll("#legend input").forEach(cb => { if (cb.checked) layers[cb.dataset.layer].addTo(map); });
  // Frame the route plus every briefed threat position and uncertainty area (not full ranges, which can be huge)
  const frame = routeLine.getBounds();
  D.threats.concat([D.target]).forEach(t => frame.extend(L.latLng(t.lat, t.lon).toBounds(2 * (t.area_km || 1) * 1000)));
  if (center) map.setView(center, zoom); else map.fitBounds(frame, { padding: [24, 24] });
}

document.querySelectorAll("#legend input").forEach(cb => cb.addEventListener("change", () => {
  cb.checked ? layers[cb.dataset.layer].addTo(map) : map.removeLayer(layers[cb.dataset.layer]);
}));

let hl;
document.querySelectorAll(".phase").forEach(li => li.querySelector(".phase-card").addEventListener("click", () => {
  document.querySelectorAll(".phase").forEach(x => x.classList.toggle("active", x === li));
  if (!map) return;
  if (hl) map.removeLayer(hl);
  const wps = D.phases[+li.dataset.idx].waypoints.map(n => wpLatLng[n]).filter(Boolean);
  if (!wps.length) { map.fitBounds(routeLine.getBounds(), { padding: [24, 24] }); return; }
  // Highlight the leg into the first waypoint through the last one in this phase
  const all = D.route.map(p => [p.lat, p.lon]);
  const names = D.route.map(p => p.name);
  const i0 = Math.max(0, names.indexOf(D.phases[+li.dataset.idx].waypoints[0]) - 1);
  const i1 = names.indexOf(D.phases[+li.dataset.idx].waypoints.at(-1));
  hl = L.polyline(all.slice(i0, i1 + 1), { color: css("--accent"), weight: 6, opacity: .85 }).addTo(map);
  map.fitBounds(L.latLngBounds(all.slice(i0, i1 + 1)).pad(0.35), { maxZoom: 10 });
  if (matchMedia("(max-width: 900px)").matches) document.getElementById("map").scrollIntoView({ behavior: "smooth" });
}));

drawMap();
</script>
</body>
</html>
