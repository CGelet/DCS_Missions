<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mission Hangar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root { --bg: #f4f2ec; --surface: #fffdf8; --ink: #1d2124; --muted: #5e646a; --line: #d6d1c4; --accent: #b4561e; --accent-ink: #fff;
  --shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.05); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #111416; --surface: #181c1f; --ink: #e6e3dc; --muted: #9aa1a6; --line: #2d3439; --accent: #e07a3c; --accent-ink: #111; --shadow: 0 1px 2px rgba(0,0,0,.4); } }
:root[data-theme="dark"] { --bg: #111416; --surface: #181c1f; --ink: #e6e3dc; --muted: #9aa1a6; --line: #2d3439; --accent: #e07a3c; --accent-ink: #111; --shadow: 0 1px 2px rgba(0,0,0,.4); }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 "IBM Plex Sans", system-ui, sans-serif; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }
@media (max-width: 640px) { .wrap { padding: 0 16px; } }
header { padding: 48px 0 28px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
.eyebrow { font: 600 13px/1 "IBM Plex Mono", monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
h1 { font-size: clamp(30px, 5vw, 46px); margin: 10px 0 8px; letter-spacing: -.02em; }
header p { color: var(--muted); margin: 0; max-width: 64ch; }
.grid { display: grid; grid-template-columns: 1fr; gap: 20px; padding-bottom: 48px; }
@media (min-width: 760px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1140px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.m[hidden], .cat[hidden] { display: none; }
.cat-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin: 8px auto 16px; }
.cat-head h2 { margin: 0; font-size: 26px; letter-spacing: -.01em; }
.cat-head p { margin: 0; color: var(--muted); font-size: 15px; }
.cat-count { font: 600 14px/1 "IBM Plex Mono", monospace; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 4px 9px; vertical-align: middle; }
.filters { display: grid; gap: 12px; margin-bottom: 24px; }
.filters input { width: 100%; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 11px 14px; }
.filters input:focus-visible, .fchip:focus-visible, .fstatus button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.fgroup { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.flabel { font: 600 12px/1 "IBM Plex Mono", monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); min-width: 120px; }
@media (max-width: 640px) { .flabel { flex-basis: 100%; } }
.fchip { font: 13px/1 "IBM Plex Sans", system-ui, sans-serif; padding: 7px 11px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
.fchip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.fstatus { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--muted); min-height: 32px; }
.fstatus button { font: 600 13px/1 "IBM Plex Sans", system-ui, sans-serif; background: none; border: 0; color: var(--accent); cursor: pointer; padding: 6px 0; }
.empty { color: var(--muted); padding: 32px 0 64px; }
.chip.role { color: var(--accent); border-color: var(--accent); }
.m { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 12px; }
.m h2 { margin: 0; font-size: 22px; line-height: 1.2; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: 12px/1 "IBM Plex Mono", monospace; padding: 5px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
.m p { margin: 0; }
.hook { border-left: 3px solid var(--accent); padding-left: 12px; font-style: italic; }
.obj { font-size: 14px; color: var(--muted); }
.obj b { color: var(--ink); }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
.actions a { text-decoration: none; font-weight: 600; font-size: 14px; padding: 9px 14px; border-radius: 8px; border: 1px solid var(--line); color: var(--ink); }
.actions a.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.camps { margin-bottom: 40px; }
.camp { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 12px; padding: 20px 22px; box-shadow: var(--shadow); }
.camp:hover { border-color: var(--muted); border-top-color: var(--accent); }
.camp b { font-size: 26px; letter-spacing: -.01em; line-height: 1.1; }
.camp .sub { font-weight: 600; }
.camp .prem { color: var(--muted); font-size: 15px; }
.camp .dates { font: 13px "IBM Plex Mono", monospace; color: var(--muted); margin-top: auto; }
.kb { display: flex; gap: 8px; overflow-x: auto; }
.kb img { height: 120px; border-radius: 4px; border: 1px solid var(--line); }
</style>
</head>
<body>
<header><div class="wrap">
  <div class="eyebrow">DCS Missions</div>
  <h1>Mission Hangar</h1>
  <p>Ready-to-fly missions. Download the .miz into <code>Saved Games/DCS/Missions/</code>, read the briefing, and print the kneeboard pages if you fly without the in-game kneeboard.</p>
</div></header>
{% if campaigns %}<section class="wrap camps" aria-labelledby="h-camps">
  <div class="cat-head"><h2 id="h-camps">Campaigns</h2><p>Story arcs flown in order. Each one installs into DCS as a campaign that unlocks the next chapter when you pass the last.</p></div>
  <div class="grid">{% for c in campaigns %}
    <a class="camp" href="campaigns/{{ c.id }}/index.html">
      <span class="eyebrow">{{ "Training campaign" if c.category == "training" else "Campaign" }} · {{ c.count }} chapters</span>
      <b>{{ c.title }}</b><span class="sub">{{ c.subtitle }}</span>
      <span class="prem">{{ c.premise }}</span>
      <span class="dates">{{ c.first }} → {{ c.last }}{% if c.setting %} · {{ c.setting }}{% endif %}</span>
    </a>{% endfor %}
  </div>
</section>{% endif %}
<div class="wrap">
  <section class="filters" aria-label="Filter missions">
    <input type="search" id="q" placeholder="Search by operation, place, story…" aria-label="Search missions">
    {% for key, label, values in filters %}{% if values %}
    <div class="fgroup" data-group="{{ key }}"><span class="flabel">{{ label }}</span>
      {% for v in values %}<button type="button" class="fchip" aria-pressed="false" data-value="{{ v }}">{{ v }}</button>{% endfor %}
    </div>{% endif %}{% endfor %}
    <div class="fstatus"><span id="count" aria-live="polite">{{ missions | length }} missions</span><button type="button" id="clear" hidden>Clear filters</button></div>
  </section>
</div>
<main>
{% for sec in sections %}{% set group = sec.missions %}{% set cat = sec.category %}
<section class="cat" data-cat="{{ sec.key }}" aria-labelledby="h-{{ sec.key }}">
  <div class="wrap cat-head"><h2 id="h-{{ sec.key }}">{{ sec.heading }} <span class="cat-count" data-total="{{ group | length }}">{{ group | length }}</span></h2><p>{{ sec.blurb }}{% if sec.link %} <a href="{{ sec.link }}">Campaign page</a>{% endif %}</p></div>
  <div class="wrap grid">
{% for m in group %}
  <article class="m" data-campaign="{{ m.campaign }}" data-aircraft="{{ m.aircraft_type }}" data-role="{{ m.role }}" data-features="{{ m.features | join('|') }}"
           data-text="{{ [m.campaign, m.operation, m.title, m.theater, m.aircraft, m.role, m.hook, m.teaser, m.objective] | join(' ') | lower }}">
    <div class="eyebrow">{% if m.chapter %}{{ m.chapter }} · {% endif %}{{ m.eyebrow }}</div>
    <h2>{{ m.title }}</h2>
    <div class="meta"><span class="chip role">{{ m.role }}</span><span class="chip">{{ m.theater }}</span><span class="chip">{{ m.aircraft }}</span><span class="chip">{{ m.date }} · {{ m.start_time }}L</span>{% for f in m.features %}<span class="chip">{{ f }}</span>{% endfor %}</div>
    {% if m.hook %}<p class="hook">{{ m.hook }}</p>{% endif %}
    <p>{{ m.teaser }}</p>
    <p class="obj"><b>Primary:</b> {{ m.objective }}</p>
    {% if m.kneeboards %}<div class="kb">{% for k in m.kneeboards %}<a href="{{ m.id }}/kneeboard/{{ k }}"><img src="{{ m.id }}/kneeboard/{{ k }}" alt="Kneeboard page {{ loop.index }}"></a>{% endfor %}</div>{% endif %}
    <div class="actions">
      <a class="primary" href="{{ m.id }}/briefing.html">Open briefing</a>
      <a href="{{ m.id }}/slides.html">Slide deck</a>
      {% if cat == "training" %}<a href="{{ m.id }}/director.html" title="Every trigger, radio call and how each grade is decided">Instructor view</a>
      {% else %}<a href="{{ m.id }}/director.html" title="Hidden units, random rolls, triggers and outcomes">Director's cut (spoilers)</a>{% endif %}
      <a href="{{ m.miz }}" download>Download .miz</a>
    </div>
  </article>
{% endfor %}
  </div>
</section>
{% endfor %}
</main>
<p class="wrap empty" id="empty" hidden>No missions match. Try removing a filter.</p>
<script>
// Within Campaign, Aircraft and Mission type, any selected value matches; selected Features must all be present.
const cards = [...document.querySelectorAll(".m")];
const q = document.getElementById("q"), count = document.getElementById("count"),
      clear = document.getElementById("clear"), empty = document.getElementById("empty");
const sel = { campaign: new Set(), aircraft: new Set(), role: new Set(), features: new Set() };
function apply() {
  const text = q.value.trim().toLowerCase();
  let n = 0;
  cards.forEach(c => {
    const has = k => c.dataset[k] ? c.dataset[k].split("|") : [];
    const ok = (!sel.campaign.size || sel.campaign.has(c.dataset.campaign))
      && (!sel.aircraft.size || has("aircraft").some(v => sel.aircraft.has(v)))
      && (!sel.role.size || has("role").some(v => sel.role.has(v)))
      && [...sel.features].every(v => has("features").includes(v))
      && (!text || text.split(/\s+/).every(w => c.dataset.text.includes(w)));
    c.hidden = !ok;
    if (ok) n++;
  });
  document.querySelectorAll(".cat").forEach(sec => {
    const shown = sec.querySelectorAll(".m:not([hidden])").length, badge = sec.querySelector(".cat-count");
    sec.hidden = shown === 0;
    badge.textContent = shown == badge.dataset.total ? shown : `${shown} of ${badge.dataset.total}`;
  });
  count.textContent = n === cards.length ? `${n} missions` : `${n} of ${cards.length} missions`;
  clear.hidden = !(text || Object.values(sel).some(s => s.size));
  empty.hidden = n > 0;
}
document.querySelectorAll(".fgroup").forEach(g => g.addEventListener("click", e => {
  const b = e.target.closest(".fchip");
  if (!b) return;
  const s = sel[g.dataset.group], on = b.getAttribute("aria-pressed") !== "true";
  b.setAttribute("aria-pressed", on);
  on ? s.add(b.dataset.value) : s.delete(b.dataset.value);
  apply();
}));
q.addEventListener("input", apply);
clear.addEventListener("click", () => {
  q.value = "";
  Object.values(sel).forEach(s => s.clear());
  document.querySelectorAll(".fchip").forEach(b => b.setAttribute("aria-pressed", "false"));
  apply();
});
</script>
</body>
</html>
