<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mission Hangar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root { --bg: #f4f2ec; --surface: #fffdf8; --ink: #1d2124; --muted: #5e646a; --line: #d6d1c4; --accent: #b4561e; --accent-ink: #fff;
  --shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.05); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #111416; --surface: #181c1f; --ink: #e6e3dc; --muted: #9aa1a6; --line: #2d3439; --accent: #e07a3c; --accent-ink: #111; --shadow: 0 1px 2px rgba(0,0,0,.4); } }
:root[data-theme="dark"] { --bg: #111416; --surface: #181c1f; --ink: #e6e3dc; --muted: #9aa1a6; --line: #2d3439; --accent: #e07a3c; --accent-ink: #111; --shadow: 0 1px 2px rgba(0,0,0,.4); }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 "IBM Plex Sans", system-ui, sans-serif; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
@media (max-width: 640px) { .wrap { padding: 0 16px; } }
header { padding: 48px 0 28px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
.eyebrow { font: 600 13px/1 "IBM Plex Mono", monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
h1 { font-size: clamp(30px, 5vw, 46px); margin: 10px 0 8px; letter-spacing: -.02em; }
header p { color: var(--muted); margin: 0; max-width: 64ch; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: 20px; padding-bottom: 48px; }
.m { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 12px; }
.m h2 { margin: 0; font-size: 22px; line-height: 1.2; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: 12px/1 "IBM Plex Mono", monospace; padding: 5px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
.m p { margin: 0; }
.hook { border-left: 3px solid var(--accent); padding-left: 12px; font-style: italic; }
.obj { font-size: 14px; color: var(--muted); }
.obj b { color: var(--ink); }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
.actions a { text-decoration: none; font-weight: 600; font-size: 14px; padding: 9px 14px; border-radius: 8px; border: 1px solid var(--line); color: var(--ink); }
.actions a.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.kb { display: flex; gap: 8px; overflow-x: auto; }
.kb img { height: 120px; border-radius: 4px; border: 1px solid var(--line); }
</style>
</head>
<body>
<header><div class="wrap">
  <div class="eyebrow">DCS Missions</div>
  <h1>Mission Hangar</h1>
  <p>Ready-to-fly missions. Download the .miz into <code>Saved Games/DCS/Missions/</code>, read the briefing, and print the kneeboard pages if you fly without the in-game kneeboard.</p>
</div></header>
<main class="wrap grid">
{% for m in missions %}
  <article class="m">
    <div class="eyebrow">Operation {{ m.operation }}</div>
    <h2>{{ m.title }}</h2>
    <div class="meta"><span class="chip">{{ m.theater }}</span><span class="chip">{{ m.aircraft }}</span><span class="chip">{{ m.date }} · {{ m.start_time }}L</span></div>
    {% if m.hook %}<p class="hook">{{ m.hook }}</p>{% endif %}
    <p>{{ m.teaser }}</p>
    <p class="obj"><b>Primary:</b> {{ m.objective }}</p>
    {% if m.kneeboards %}<div class="kb">{% for k in m.kneeboards %}<a href="{{ m.id }}/kneeboard/{{ k }}"><img src="{{ m.id }}/kneeboard/{{ k }}" alt="Kneeboard page {{ loop.index }}"></a>{% endfor %}</div>{% endif %}
    <div class="actions">
      <a class="primary" href="{{ m.id }}/briefing.html">Open briefing</a>
      <a href="{{ m.id }}/{{ m.id }}.miz" download>Download .miz</a>
    </div>
  </article>
{% endfor %}
</main>
</body>
</html>
