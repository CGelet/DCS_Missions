<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ narrative.operation | title }} Brief</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* Presenter deck. Dark only: it's built for a projector or a shared screen in a dim room. */
:root {
  --bg: #0d1012; --slide: #13171a; --ink: #ece8df; --muted: #9aa1a6; --line: #2a3136; --accent: #e07a3c;
  --blue: #7fb0f0; --red: #ef6b62; --amber: #e3a93b; --ok: #6cc28f; --radio-bg: #08100b; --radio-ink: #a6efbc;
  --sea: #10202b; --coast: #8aa3b3;
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font-family: "IBM Plex Sans", system-ui, sans-serif; overflow: hidden; }
.mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }

#stage { position: absolute; left: 50%; top: 50%; width: 1600px; height: 900px; transform-origin: 0 0; }
.slide { position: absolute; inset: 0; background: var(--slide); padding: 80px 96px; display: none; flex-direction: column; overflow: hidden; }
.slide.on { display: flex; }
.slide::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: var(--accent); }
.eyebrow { font: 600 22px/1 "IBM Plex Mono", monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); margin-bottom: 22px; }
h1 { font-size: 92px; line-height: 1.02; margin: 0; letter-spacing: -.025em; max-width: 1300px; }
h2 { font-size: 60px; line-height: 1.06; margin: 0 0 32px; letter-spacing: -.02em; }
p { margin: 0 0 22px; }
.big { font-size: 42px; line-height: 1.38; max-width: 1280px; }
.body { font-size: 28px; line-height: 1.45; color: var(--ink); }
.muted { color: var(--muted); }
.foot { position: absolute; left: 96px; right: 96px; bottom: 36px; display: flex; justify-content: space-between; font: 18px "IBM Plex Mono", monospace; color: var(--muted); }

.title { justify-content: center; }
.title .sub { margin-top: 30px; font: 26px "IBM Plex Mono", monospace; color: var(--muted); }
.title blockquote { margin: 56px 0 0; padding: 0 0 0 28px; border-left: 4px solid var(--accent); font-size: 34px; line-height: 1.4; max-width: 1150px; font-style: italic; }
.story { justify-content: center; }
.divider { justify-content: center; }
.divider h1 { font-size: 120px; }

.split { display: grid; grid-template-columns: 560px 1fr; gap: 56px; flex: 1; min-height: 0; align-items: center; }
.split.nomap { grid-template-columns: 1fr; max-width: 1200px; }
.split .text { align-self: center; }
.radio { margin-top: 26px; background: var(--radio-bg); color: var(--radio-ink); font: 23px/1.5 "IBM Plex Mono", monospace; padding: 20px 24px; border-radius: 10px; border: 1px solid #1d3326; }
.radio .lbl { display: block; font-size: 15px; letter-spacing: .16em; opacity: .7; margin-bottom: 6px; }

svg.map { width: 100%; height: 100%; max-height: 680px; border-radius: 14px; border: 1px solid var(--line); }
svg.map .sea { fill: var(--sea); }
svg.map .grid { stroke: #ffffff10; stroke-width: 1; }
svg.map .gridlbl { fill: #ffffff40; font: 12px "IBM Plex Mono", monospace; }
svg.map .coast { fill: none; stroke: var(--coast); stroke-width: 2; stroke-linejoin: round; }
svg.map .ring { fill-opacity: .1; stroke-width: 2; }
svg.map .ring.suspected { stroke-dasharray: 10 6; }
svg.map .ring.possible { stroke-dasharray: 3 7; fill-opacity: .04; opacity: .6; }
svg.map .area { fill: none; stroke-width: 1.5; stroke-dasharray: 1 6; stroke-linecap: round; }
svg.map .area.sam { stroke: var(--red); } svg.map .area.aaa { stroke: var(--amber); } svg.map .area.air { stroke: var(--blue); } svg.map .area.armor { stroke: var(--muted); }
svg.map .threat.armor, svg.map .ring.armor { fill: var(--muted); stroke: var(--muted); }
svg.map .threat.suspected, svg.map .threat.possible { fill: var(--slide) !important; stroke-width: 3; }
svg.map .threat.suspected.sam, svg.map .threat.possible.sam { stroke: var(--red); }
svg.map .threat.suspected.aaa, svg.map .threat.possible.aaa { stroke: var(--amber); }
svg.map .threat.suspected.air, svg.map .threat.possible.air { stroke: var(--blue); }
svg.map .threat.suspected.armor, svg.map .threat.possible.armor { stroke: var(--muted); }
svg.map .ship { fill: var(--slide); stroke: var(--ok); stroke-width: 4; }
svg.map .shiptrack { fill: none; stroke: var(--ok); stroke-width: 3; stroke-dasharray: 2 9; stroke-linecap: round; }
svg.map .flighttrack { fill: none; stroke: var(--ok); stroke-width: 2.5; stroke-dasharray: 10 6; }
svg.map .orbit { stroke: var(--ok); stroke-width: 7; stroke-linecap: round; opacity: .45; }
svg.profile { width: 100%; height: auto; }
.rulelist { margin: 0; padding-left: 1.2em; display: grid; gap: 10px; font-size: 25px; line-height: 1.35; }
.kio { margin-top: 22px; font-size: 22px; border-left: 5px solid var(--red, #d9534f); padding-left: 16px; }
svg.profile .pgrid { stroke: #ffffff18; } svg.profile .paxis, svg.profile .psub { fill: var(--muted); font: 15px "IBM Plex Mono", monospace; }
svg.profile .pleg { stroke: var(--blue); stroke-width: 4; stroke-linecap: round; } svg.profile .pleg.agl { stroke: var(--accent); stroke-dasharray: 8 6; }
svg.profile .pwp { fill: var(--slide); stroke: var(--blue); stroke-width: 3; } svg.profile .pwp.agl { stroke: var(--accent); }
svg.profile .plbl { fill: var(--ink); font: 600 14px "IBM Plex Mono", monospace; }
svg.map .search { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 6 8; }
svg.map .ring.sam, svg.map .threat.sam { fill: var(--red); stroke: var(--red); }
svg.map .ring.aaa, svg.map .threat.aaa { fill: var(--amber); stroke: var(--amber); }
svg.map .threat.air { fill: var(--blue); }
svg.map .route { fill: none; stroke: var(--blue); stroke-width: 4; stroke-linejoin: round; }
svg.map .route.dim { opacity: .35; }
svg.map .route.hl { stroke: var(--accent); stroke-width: 7; }
svg.map .cap { stroke: var(--ok); stroke-width: 4; stroke-dasharray: 3 9; stroke-linecap: round; }
svg.map .friendly-dot { fill: var(--ok); }
svg.map .wp { fill: var(--slide); stroke: var(--blue); stroke-width: 3; }
svg.map .wp.on { stroke: var(--accent); fill: var(--accent); }
svg.map .lbl { fill: var(--ink); font: 600 17px "IBM Plex Mono", monospace; paint-order: stroke; stroke: var(--sea); stroke-width: 5px; }
svg.map .lbl.friendly { fill: var(--ok); }
svg.map .lbl.sam { fill: var(--red); }
svg.map .lbl.aaa { fill: var(--amber); }
svg.map .lbl.air { fill: var(--blue); }
svg.map .lbl.armor { fill: var(--ink); }
svg.map .lbl.hazard, svg.map .lbl.hostile { fill: var(--red); }
svg.map .threat.hazard { fill: none; stroke: var(--red); stroke-width: 3; }
svg.map .ring.hazard { fill: #ef6b6218; stroke: var(--red); stroke-width: 2; stroke-dasharray: 3 5; }
svg.map .flighttrack.hostile { stroke: var(--red); }
svg.map .hostile-dot { fill: var(--red); }
svg.map .target circle, svg.map .target path { fill: none; stroke: var(--accent); stroke-width: 3.5; }

.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.card { background: #ffffff08; border: 1px solid var(--line); border-radius: 14px; padding: 26px 30px; }
.card b { display: block; font-size: 30px; margin-bottom: 6px; }
.card span { font-size: 23px; color: var(--muted); }

.rows { display: grid; gap: 0; max-width: 1350px; }
.row { display: grid; grid-template-columns: 260px 1fr; gap: 28px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 28px; line-height: 1.4; }
.row:last-child { border-bottom: 0; }
.row .k { font: 600 18px/1.9 "IBM Plex Mono", monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.tag { display: inline-block; font: 600 16px/1 "IBM Plex Mono", monospace; padding: 7px 10px; border-radius: 6px; text-transform: uppercase; }
.tag.sam { background: #ef6b6222; color: var(--red); }
.tag.aaa { background: #e3a93b22; color: var(--amber); }
.tag.air { background: #7fb0f022; color: var(--blue); }
.tag.armor { background: #ffffff14; color: var(--ink); }
.tag.hazard { color: var(--red); border: 1.5px dashed var(--red); }
.intel { display: inline-block; font: 600 15px/1 "IBM Plex Mono", monospace; padding: 6px 9px; border-radius: 6px; text-transform: uppercase; border: 1.5px solid currentColor; margin-left: 10px; vertical-align: 3px; }
.intel.confirmed { color: var(--ok); } .intel.suspected { color: var(--amber); } .intel.possible { color: var(--muted); border-style: dashed; }
.chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.chip { font: 20px "IBM Plex Mono", monospace; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--ok); }

.outcome .band { height: 10px; width: 220px; border-radius: 5px; margin-bottom: 36px; }
.outcome.success .band { background: var(--ok); }
.outcome.partial .band { background: var(--amber); }
.outcome.failure .band { background: var(--red); }

#progress { position: fixed; left: 0; bottom: 0; height: 4px; background: var(--accent); transition: width .2s; z-index: 5; }
#notes { position: fixed; left: 0; right: 0; bottom: 0; background: #000000e6; color: #ddd; font: 18px/1.5 "IBM Plex Sans", sans-serif; padding: 16px 24px 20px; display: none; z-index: 4; border-top: 1px solid var(--line); }
#notes.on { display: block; }
#notes .k { font: 600 13px "IBM Plex Mono", monospace; letter-spacing: .14em; color: var(--accent); margin-right: 12px; }
#help { position: fixed; right: 16px; top: 12px; font: 13px "IBM Plex Mono", monospace; color: #ffffff55; z-index: 5; }

@media print {
  @page { size: 1600px 900px; margin: 0; }
  html, body { overflow: visible; height: auto; background: var(--slide); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  #stage { position: static; transform: none !important; width: 1600px; height: auto; }
  .slide { position: relative; display: flex !important; width: 1600px; height: 900px; page-break-after: always; break-after: page; }
  #progress, #notes, #help { display: none !important; }
}
</style>
</head>
<body>
<div id="stage">
{% for s in slides %}
<section class="slide {{ s.kind }}{% if s.tone %} {{ s.tone }}{% endif %}" data-notes="{{ s.notes }}" aria-label="Slide {{ loop.index }}">
  {% if s.kind in ("title", "divider") %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h1>{{ s.title }}</h1>
    {% if s.sub %}<div class="sub">{{ s.sub }}</div>{% endif %}
    {% if s.quote %}<blockquote>{{ s.quote }}</blockquote>{% endif %}

  {% elif s.kind == "story" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <p class="big">{{ s.text }}</p>

  {% elif s.kind == "cast" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>The voices you'll hear</h2>
    <div class="cards">{% for c in s.entries %}<div class="card"><b>{{ c.name }}</b><span>{{ c.role }}</span></div>{% endfor %}</div>

  {% elif s.kind in ("map", "phase") %}
    <div class="split{% if not s.svg %} nomap{% endif %}">
      <div class="text">
        <div class="eyebrow">{{ s.eyebrow }}</div>
        <h2>{{ s.title }}</h2>
        <div class="body">{% for p in s.text | paras %}<p>{{ p }}</p>{% endfor %}</div>
        {% if s.radio %}<div class="radio"><span class="lbl">RADIO</span>{{ s.radio }}</div>{% endif %}
      </div>
      {% if s.svg %}<div class="mapcell">{{ s.svg }}</div>{% endif %}
    </div>

  {% elif s.kind == "profile" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div style="flex:1;display:flex;align-items:center">{{ s.svg }}</div>
    <p class="muted" style="font-size:22px;margin:0">Dashed legs are flown above ground level, following the terrain.</p>

  {% elif s.kind == "objectives" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div class="rows">{% for k, v in s.entries %}<div class="row"><span class="k">{{ k }}</span><span>{{ v }}</span></div>{% endfor %}</div>

  {% elif s.kind == "threats" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div class="rows">{% for t in s.entries %}<div class="row"><span><span class="tag {{ t.kind }}">{{ t.kind }}</span></span>
      <span><b>{{ t.name }}</b>{% if not s.training %}<span class="intel {{ t.intel or 'confirmed' }}">{{ t.intel or "confirmed" }}</span>{% endif %}{% if t.range_km %} <span class="muted mono">· {{ t.range_km }} km</span>{% endif %}<br><span class="muted">{{ t.notes }}</span></span></div>{% endfor %}</div>

  {% elif s.kind == "package" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div class="rows">{% for k, v in s.rows %}<div class="row"><span class="k">{{ k }}</span><span>{{ v }}</span></div>{% endfor %}</div>
    {% if s.support %}<div class="chips">{% for x in s.support %}<span class="chip">{{ x }}</span>{% endfor %}</div>{% endif %}

  {% elif s.kind == "comms" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div class="rows">{% for c in s.entries %}<div class="row"><span class="k mono" style="text-transform:none;letter-spacing:0;font-size:24px;color:var(--ink)">{{ c.freq }}</span><span>{{ c.name }} <span class="muted mono">· {{ c.preset }}</span>{% if c.notes %}<br><span class="muted" style="font-size:22px">{{ c.notes }}</span>{% endif %}</span></div>{% endfor %}</div>

  {% elif s.kind == "rules" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <ol class="rulelist">{% for r in s.entries %}<li>{{ r }}</li>{% endfor %}</ol>
    {% if s.kio %}<p class="kio"><b>Knock-it-off / terminate:</b> {{ s.kio }}</p>{% endif %}

  {% elif s.kind == "grade" %}
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <div class="rows">{% for g in s.entries %}<div class="row"><span class="k">{{ g.item }}</span><span>{{ g.standard }}</span></div>{% endfor %}</div>

  {% elif s.kind == "outcome" %}
    <div class="band"></div>
    <div class="eyebrow">{{ s.eyebrow }}</div>
    <h2>{{ s.title }}</h2>
    <p class="big">{{ s.text }}</p>
  {% endif %}
  <div class="foot"><span>{{ "TRAINING" if meta.category == "training" else "OP" }} {{ narrative.operation }}</span><span>{{ loop.index }} / {{ loop.length }}</span></div>
</section>
{% endfor %}
</div>
<div id="progress"></div>
<div id="notes"><span class="k">NOTES</span><span id="notes-text"></span></div>
<div id="help">← → navigate · N notes · F fullscreen</div>
<script>
const slides = [...document.querySelectorAll(".slide")];
const stage = document.getElementById("stage");
let cur = 0;

function fit() {
  const s = Math.min(innerWidth / 1600, innerHeight / 900);
  stage.style.transform = `scale(${s}) translate(-50%, -50%)`;
}
function show(i) {
  cur = Math.max(0, Math.min(slides.length - 1, i));
  slides.forEach((el, j) => el.classList.toggle("on", j === cur));
  document.getElementById("progress").style.width = `${(cur + 1) / slides.length * 100}%`;
  document.getElementById("notes-text").textContent = slides[cur].dataset.notes || "(no notes)";
  history.replaceState(null, "", `#${cur + 1}`);
}
addEventListener("keydown", e => {
  if (["ArrowRight", "PageDown", " ", "Enter"].includes(e.key)) { e.preventDefault(); show(cur + 1); }
  else if (["ArrowLeft", "PageUp", "Backspace"].includes(e.key)) { e.preventDefault(); show(cur - 1); }
  else if (e.key === "Home") show(0);
  else if (e.key === "End") show(slides.length - 1);
  else if (e.key.toLowerCase() === "n") document.getElementById("notes").classList.toggle("on");
  else if (e.key.toLowerCase() === "f") document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.();
});
addEventListener("click", e => { if (!e.target.closest("a")) show(cur + (e.clientX > innerWidth / 3 ? 1 : -1)); });
let tx = null;
addEventListener("touchstart", e => { tx = e.touches[0].clientX; }, { passive: true });
addEventListener("touchend", e => { if (tx !== null) { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1)); tx = null; } });
addEventListener("resize", fit);
fit();
show((parseInt(location.hash.slice(1)) || 1) - 1);
</script>
</body>
</html>
